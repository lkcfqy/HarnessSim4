    <material name="connector_dark" rgba=".018 .024 .030 1" specular=".24" shininess=".25"/>
    <material name="metal" rgba=".42 .46 .50 1" specular=".72" shininess=".55"/>
    <material name="frame" rgba=".10 .12 .14 1" specular=".55" shininess=".45"/>
    <material name="guard" rgba=".12 .45 .62 .16" specular=".8" shininess=".7"/>
