  <statistic center="0 0 .22" extent="1.5"/>
  <visual>
    <global offwidth="1920" offheight="1080"/>
    <headlight ambient=".20 .22 .25" diffuse=".52 .55 .58" specular=".25 .25 .25"/>
    <quality shadowsize="8192" offsamples="4" numslices="32" numstacks="24"/>
    <map znear=".01" zfar="8" fogstart="3" fogend="6"/>
