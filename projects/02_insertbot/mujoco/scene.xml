        <config key="twist" value="2e5"/>
        <config key="bend" value="8e4"/>
        <config key="vmax" value=".08"/>
      </plugin>
      <joint kind="main" damping=".025"/>
      <geom type="capsule" size=".006" material="wire" condim="3" friction=".08 .005 .001"/>
    </composite>
  </worldbody>
  <equality>
    <connect name="terminal_grasp" body1="insert_B_last" body2="gripper" anchor=".01 0 0"/>
    <weld name="terminal_servo" body1="terminal_tool" body2="gripper" solref=".008 1" solimp=".92 .97 .0008"/>
  </equality>
  <contact>
    <exclude body1="insert_B_last" body2="gripper"/>
  </contact>
