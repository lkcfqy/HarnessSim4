    <geom type="box" size=".045 .045 .34" pos="-.62 -.45 -.38" material="frame" contype="0" conaffinity="0"/>
    <geom type="box" size=".045 .045 .34" pos=".62 -.45 -.38" material="frame" contype="0" conaffinity="0"/>
    <geom type="box" size=".045 .045 .34" pos="-.62 .45 -.38" material="frame" contype="0" conaffinity="0"/>
    <geom type="box" size=".045 .045 .34" pos=".62 .45 -.38" material="frame" contype="0" conaffinity="0"/>
    <geom type="cylinder" size=".17 .10" pos="0 -.73 -.10" material="frame" contype="0" conaffinity="0"/>
    <geom type="box" size=".008 .52 .40" pos="-.74 0 .36" material="guard" contype="0" conaffinity="0"/>
    <geom type="box" size=".008 .52 .40" pos=".74 0 .36" material="guard" contype="0" conaffinity="0"/>
    <body name="cell_focus" pos="0 -.03 .18"/>
    <camera name="overview" mode="targetbodycom" target="cell_focus" pos="1.48 -1.78 1.28" fovy="43"/>
    <camera name="process_view" mode="targetbodycom" target="cell_focus" pos=".85 -.95 .60" fovy="34"/>
    <camera name="contact_view" mode="targetbodycom" target="connector" pos=".55 -.46 .31" fovy="28"/>
    <body name="root_fixture" pos="-.45 0 .13">
